<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This assembly only ever runs on Linux, but annotating it
         [SupportedOSPlatform("linux")] would cascade CA1416 into every
         cross-platform head that references it. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="drm-dotnet" />
    <PackageReference Include="mesa-dotnet" />
    <PackageReference Include="seatd-dotnet" />
    <PackageReference Include="WaylandSharpest" />
    <ProjectReference Include="../FreqScene.Core/FreqScene.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WaylandProtocol Include="protocol/xdg-shell.xml" WaylandNamespace="FreqScene.WaylandProtocols" />
    <WaylandProtocol Include="protocol/wlr-layer-shell-unstable-v1.xml" WaylandNamespace="FreqScene.WaylandProtocols" />
  </ItemGroup>
</Project>
