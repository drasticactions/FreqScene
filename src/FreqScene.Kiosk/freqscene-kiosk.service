# FreqScene
#
# Install:
#   sudo cp freqscene-kiosk.service /etc/systemd/system/
#   sudo cp -r . /opt/freqscene-kiosk
#   sudo systemctl enable --now freqscene-kiosk
[Unit]
Description=FreqScene
After=systemd-user-sessions.service seatd.service
Wants=seatd.service

[Service]
Type=simple
User=freqscene
SupplementaryGroups=video render
WorkingDirectory=/opt/freqscene-kiosk
ExecStart=/opt/freqscene-kiosk/freqscene-kiosk --backend drm
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
